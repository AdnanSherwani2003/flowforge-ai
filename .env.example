# Fresh trusted-local installation only. Never replace an existing .env.
# Replace all four placeholders with independent random URL-safe values.
POSTGRES_ADMIN_PASSWORD=replace_me
FLOWFORGE_DB_PASSWORD=replace_me
N8N_DB_PASSWORD=replace_me
# Preserve this key with backups: it decrypts n8n credentials.
N8N_ENCRYPTION_KEY=replace_me

GENERIC_TIMEZONE=Asia/Kolkata
FLOWFORGE_DIGEST_TIMEZONE=Asia/Kolkata
FLOWFORGE_ENABLE_SIMULATION=false
FLOWFORGE_ENRICHMENT_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_MODEL_DIGEST=357c53fb659c5076de1d65ccb0b397446227b71a42be9d1603d46168015c9e4b
OLLAMA_TIMEOUT_SECONDS=25
OLLAMA_NUM_GPU=-1

# After building, setup_reviewer.py appends reviewer authentication privately.
# After first n8n owner/lead setup, setup_digest_service.py appends its scoped key
# and encrypted credential. Do not pre-fill blank script-managed settings.
# See docs/developer-setup.md. The isolated lab generates independent private
# configuration outside Git and never reads or overwrites this project's .env.
